{
  "framework": null,
  "installCommand": "npm install -g pnpm@9.15.9 && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "site/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
